# Required: a GitHub token with repo read access. Easiest: `gh auth token`
GH_TOKEN=
# Optional: whose open PRs to scan (defaults to the token's owner)
GITHUB_AUTHOR=
# Optional: host port (default 8787), cache TTL seconds (default 300), parallel PR fetches (default 8)
PORT=
CACHE_TTL_SECONDS=
CONCURRENCY=
# Optional: include PRs merged within this many days (default 30)
MERGED_DAYS=
# Optional: where your clones live, for "Open in VS Code" links. owner/name maps to
# REPOS_DIR/name (default: your home dir). Override individual repos with REPO_PATHS.
REPOS_DIR=
REPO_PATHS=   # e.g. my-org/web=/Users/me/code/web,my-org/other=/Users/me/other
